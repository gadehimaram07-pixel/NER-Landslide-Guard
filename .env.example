# NER-LandslideGuard - Environment Configuration Template
# Copy this file to .env and fill in any credentials if available.
# DO NOT commit .env containing real credentials.

# NASA Earthdata Login (for IMERG / SRTM automated retrieval)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# OpenTopography API Key (optional for SRTM high-res DEMs)
OPENTOPOGRAPHY_API_KEY=

# ISRIC SoilGrids REST / WCS API Endpoint (public, no key required)
SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# Central Dashboard & API Configuration
API_PORT=8000
HOST=127.0.0.1
DEBUG=True
